---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_LANG } from '../consts';
---

<!doctype html>
<html lang={SITE_LANG}>
<head>
<BaseHead title={`${SITE_TITLE} · About`} description="About this site" />
</head>
<body>
<div class="site-shell">
<Header />
<Navbar />
<main>
<article class="prose article-card">
<h1>About</h1>
<p>
This site has been reshaped to match the default reading-oriented style of
<code>astro-theme-retypeset</code>, with focus on typography, spacing, and list-based
post browsing.
</p>
<p>
Start from the homepage for recent posts, or open Archive to browse all articles.
</p>
</article>
</main>
<Footer />
</div>
</body>
</html>
